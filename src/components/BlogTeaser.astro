---
import { getCollection } from 'astro:content';
import { pathFor, type Locale } from '../utils/i18n';
import { readingTime } from '../utils/reading-time';
import Icon from './Icon.astro';

interface Props {
  blog: {
    heading: string;
    kicker: string;
    intro: string;
    viewAll: string;
    readingTime: string;
    emptyState: string;
  };
  locale: Locale;
}

const { blog, locale } = Astro.props;

const allPosts = await getCollection('blog', (entry) => entry.data.lang === locale && !entry.data.draft);
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const blogIndexHref = pathFor(locale, '/blog');
const dateFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-CL' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<section id="blog" class="section blog-teaser" aria-labelledby="blog-heading">
  <div class="container">
    <div class="section-head blog-teaser__head">
      <div>
        <span class="section-kicker">{blog.kicker}</span>
        <h2 class="section-title" id="blog-heading">{blog.heading}</h2>
        <p class="blog-teaser__intro">{blog.intro}</p>
      </div>
      <a href={blogIndexHref} class="btn btn-secondary blog-teaser__view-all">
        {blog.viewAll}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p class="blog-teaser__empty" data-reveal>{blog.emptyState}</p>
      ) : (
        <div class="blog-teaser__grid">
          {posts.map((post, i) => (
            <a
              href={`${pathFor(locale, '/blog/' + post.id)}`}
              class="card card-interactive blog-teaser__card"
              data-reveal
              style={`transition-delay:${Math.min(i, 3) * 60}ms`}
            >
              <p class="blog-teaser__date">{dateFormatter.format(post.data.pubDate)}</p>
              <h3>{post.data.title}</h3>
              <p class="blog-teaser__description">{post.data.description}</p>
              <p class="blog-teaser__reading-time">
                <Icon name="clock" size={14} />
                {readingTime(post.body ?? '')} {blog.readingTime}
              </p>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .blog-teaser__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
  }

  .blog-teaser__intro {
    margin-top: var(--space-3);
    color: var(--text-secondary);
    max-width: 60ch;
  }

  .blog-teaser__view-all {
    flex-shrink: 0;
  }

  .blog-teaser__empty {
    padding: var(--space-10);
    text-align: center;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .blog-teaser__grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .blog-teaser__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-teaser__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .blog-teaser__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .blog-teaser__card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .blog-teaser__description {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .blog-teaser__reading-time {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
