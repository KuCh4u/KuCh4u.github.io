---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { Locale } from '../utils/i18n';
import { pathFor } from '../utils/i18n';
import type { UiStrings } from '../data/ui-strings';

interface Props {
  locale: Locale;
  nav: Record<string, string>;
  name: string;
  themeLabels: { light: string; dark: string };
  ui: UiStrings;
  esHref: string;
  enHref: string;
  esAvailable?: boolean;
  enAvailable?: boolean;
  unavailableTitle?: string;
}

const {
  locale,
  nav,
  name,
  themeLabels,
  ui,
  esHref,
  enHref,
  esAvailable = true,
  enAvailable = true,
  unavailableTitle,
} = Astro.props;
const home = pathFor(locale, '/');

const navLinks = [
  { key: 'about', href: `${home}#about` },
  { key: 'skills', href: `${home}#skills` },
  { key: 'experience', href: `${home}#experience` },
  { key: 'projects', href: `${home}#projects` },
  { key: 'certifications', href: `${home}#certifications` },
  { key: 'education', href: `${home}#education` },
  { key: 'blog', href: `${home}#blog` },
];

const contactHref = `${home}#contact`;
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a href={home} class="brand" aria-label={`${name} — ${nav.home}`}>
      NC<span class="brand__cursor" aria-hidden="true">_</span>
    </a>

    <nav class="primary-nav" aria-label={ui.navPrimary}>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{nav[link.key]}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher
        locale={locale}
        esHref={esHref}
        enHref={enHref}
        esAvailable={esAvailable}
        enAvailable={enAvailable}
        unavailableTitle={unavailableTitle}
      />
      <ThemeToggle labelLight={themeLabels.light} labelDark={themeLabels.dark} />
      <a href={contactHref} class="btn btn-secondary site-header__cta">{nav.contact}</a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={ui.menuOpen}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="mobile-menu__panel">
      <div class="mobile-menu__head">
        <span class="brand">NC<span class="brand__cursor" aria-hidden="true">_</span></span>
        <button type="button" id="mobile-menu-close" class="mobile-menu-close" aria-label={ui.menuClose}>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <ul class="mobile-menu__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="mobile-menu-link">{nav[link.key]}</a>
            </li>
          ))
        }
        <li>
          <a href={contactHref} class="mobile-menu-link">{nav.contact}</a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    height: 64px;
    display: flex;
    align-items: center;
    background: linear-gradient(to bottom, rgba(10, 14, 20, 0.6), transparent);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      border-color var(--dur-base) var(--ease-standard),
      backdrop-filter var(--dur-base) var(--ease-standard);
  }

  :global([data-theme='light']) .site-header {
    background: linear-gradient(to bottom, rgba(247, 248, 250, 0.7), transparent);
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bg-surface) 92%, transparent);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(8px);
  }

  @media (min-width: 1024px) {
    .site-header {
      height: 72px;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--space-4);
  }

  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-lg);
    text-decoration: none;
    color: var(--text-primary);
    letter-spacing: 0.02em;
  }

  .brand__cursor {
    color: var(--accent-primary);
  }

  .primary-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .primary-nav {
      display: block;
    }

    .primary-nav ul {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }

    .primary-nav a {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: 0.02em;
      white-space: nowrap;
      color: var(--text-secondary);
      text-decoration: none;
      padding-block: var(--space-2);
      background-image: linear-gradient(var(--accent-info), var(--accent-info));
      background-repeat: no-repeat;
      background-position: left bottom;
      background-size: 0% 2px;
      transition:
        background-size var(--dur-fast) var(--ease-standard),
        color var(--dur-fast) var(--ease-standard);
    }

    .primary-nav a:hover,
    .primary-nav a:focus-visible {
      color: var(--text-primary);
      background-size: 100% 2px;
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__cta {
    display: none;
  }

  @media (min-width: 1024px) {
    .site-header__cta {
      display: inline-flex;
      padding: 8px 18px;
      min-height: 36px;
    }
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--text-primary);
  }

  .mobile-menu-toggle:hover {
    background: var(--bg-surface-2);
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--overlay-scrim);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(85vw, 360px);
    background: var(--bg-surface);
    border-left: 1px solid var(--border-subtle);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .mobile-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-menu-close {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    color: var(--text-primary);
  }

  .mobile-menu-close:hover {
    background: var(--bg-surface-2);
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-menu-link {
    display: block;
    padding: var(--space-3) var(--space-2);
    font-size: var(--text-xl);
    font-weight: 500;
    text-decoration: none;
    color: var(--text-primary);
    border-radius: var(--radius-md);
    min-height: 44px;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link:focus-visible {
    background: var(--bg-surface-2);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menuClose = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  let lastFocused: HTMLElement | null = null;

  function getFocusable(container: HTMLElement) {
    return Array.from(
      container.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    );
  }

  function openMenu() {
    if (!menu) return;
    lastFocused = document.activeElement as HTMLElement;
    menu.hidden = false;
    menuToggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    const focusable = getFocusable(menu);
    focusable[0]?.focus();
  }

  function closeMenu() {
    if (!menu) return;
    menu.hidden = true;
    menuToggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  menu?.addEventListener('click', (e) => {
    if (e.target === menu) closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (!menu || menu.hidden) return;
    if (e.key === 'Escape') {
      closeMenu();
      return;
    }
    if (e.key === 'Tab') {
      const focusable = getFocusable(menu);
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
</script>
