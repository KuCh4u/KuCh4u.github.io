---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { readingTime } from '../utils/reading-time';
import type { Locale } from '../utils/i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  Content: any;
  locale: Locale;
  blogHref: string;
  prev: { href: string; title: string } | null;
  next: { href: string; title: string } | null;
  blog: {
    readingTime: string;
    tagsLabel: string;
    backToBlog: string;
    prev: string;
    next: string;
    publishedOn: string;
  };
}

const { post, Content, blogHref, prev, next, blog } = Astro.props;
const { data, body } = post;
const dateFormatter = new Intl.DateTimeFormat(data.lang === 'es' ? 'es-CL' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const minutes = readingTime(body ?? '');
---

<article class="section blog-post">
  <div class="container blog-post__container">
    <a href={blogHref} class="blog-post__back">
      <Icon name="arrow-right" size={14} class="blog-post__back-icon" />
      {blog.backToBlog}
    </a>

    <header class="blog-post__head">
      <h1>{data.title}</h1>
      <p class="blog-post__description">{data.description}</p>
      <div class="blog-post__meta">
        <span>
          <Icon name="calendar" size={14} />
          {blog.publishedOn} {dateFormatter.format(data.pubDate)}
        </span>
        <span>
          <Icon name="clock" size={14} />
          {minutes} {blog.readingTime}
        </span>
      </div>
      {data.tags.length > 0 && (
        <ul class="blog-post__tags" aria-label={blog.tagsLabel}>
          {data.tags.map((tag: string) => (
            <li class="tag">
              <Icon name="tag" size={12} />
              {tag}
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="blog-post__prose">
      <Content />
    </div>

    <nav class="blog-post__nav" aria-label={`${blog.prev} / ${blog.next}`}>
      {prev ? (
        <a href={prev.href} class="blog-post__nav-link blog-post__nav-link--prev">
          <span class="blog-post__nav-label">{blog.prev}</span>
          <span class="blog-post__nav-title">{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={next.href} class="blog-post__nav-link blog-post__nav-link--next">
          <span class="blog-post__nav-label">{blog.next}</span>
          <span class="blog-post__nav-title">{next.title}</span>
        </a>
      ) : <span />}
    </nav>
  </div>
</article>

<style>
  .blog-post__container {
    max-width: 760px;
  }

  .blog-post__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-8);
  }

  .blog-post__back:hover {
    color: var(--accent-primary);
  }

  .blog-post__back-icon {
    transform: rotate(180deg);
  }

  .blog-post__head {
    margin-bottom: var(--space-8);
  }

  .blog-post__head h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .blog-post__description {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-5);
  }

  .blog-post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
  }

  .blog-post__meta span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-post__tags .tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .blog-post__prose {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-primary);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-8);
  }

  .blog-post__prose :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .blog-post__prose :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .blog-post__prose :global(p) {
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    max-width: 68ch;
  }

  .blog-post__prose :global(ul),
  .blog-post__prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
    color: var(--text-secondary);
  }

  .blog-post__prose :global(ul) {
    list-style: disc;
  }

  .blog-post__prose :global(ol) {
    list-style: decimal;
  }

  .blog-post__prose :global(a) {
    color: var(--accent-info);
  }

  .blog-post__prose :global(pre) {
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    line-height: var(--leading-mono);
    border: 1px solid var(--border-subtle);
  }

  .blog-post__prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .blog-post__prose :global(:not(pre) > code) {
    background: var(--bg-surface-2);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .blog-post__prose :global(blockquote) {
    border-left: 3px solid var(--accent-info);
    padding-left: var(--space-4);
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: var(--space-4);
  }

  .blog-post__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .blog-post__nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }

  .blog-post__nav-link:hover {
    border-color: var(--border-strong);
  }

  .blog-post__nav-link--next {
    text-align: right;
    grid-column: 2;
  }

  .blog-post__nav-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .blog-post__nav-title {
    color: var(--text-primary);
    font-size: var(--text-sm);
  }
</style>
