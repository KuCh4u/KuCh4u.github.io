---
interface Props {
  labelLight: string;
  labelDark: string;
}
const { labelLight, labelDark } = Astro.props;
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-pressed="false"
  data-label-light={labelLight}
  data-label-dark={labelDark}
>
  <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
  <span class="sr-only" id="theme-toggle-label">{labelDark}</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-secondary);
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      transform var(--dur-instant) var(--ease-standard);
  }

  .theme-toggle:hover {
    background: var(--bg-surface-2);
    color: var(--text-primary);
  }

  .theme-toggle:active {
    transform: scale(0.92);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle:active {
      transform: none;
    }
  }

  .theme-toggle__icon--moon {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__icon--sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__icon--moon {
    display: inline-flex;
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const label = document.getElementById('theme-toggle-label');

  function currentTheme(): 'light' | 'dark' {
    return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  function syncA11y() {
    if (!toggle || !label) return;
    const theme = currentTheme();
    const labelLight = toggle.getAttribute('data-label-light') || 'Switch to light mode';
    const labelDark = toggle.getAttribute('data-label-dark') || 'Switch to dark mode';
    toggle.setAttribute('aria-pressed', theme === 'light' ? 'true' : 'false');
    toggle.setAttribute('aria-label', theme === 'light' ? labelDark : labelLight);
    label.textContent = theme === 'light' ? labelDark : labelLight;
  }

  syncA11y();

  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'light' ? 'dark' : 'light';
    if (next === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* no-op */
    }
    syncA11y();
  });
</script>
