---
interface Props {
  name:
    | 'email'
    | 'linkedin'
    | 'github'
    | 'credly'
    | 'hackthebox'
    | 'tryhackme'
    | 'sun'
    | 'moon'
    | 'menu'
    | 'close'
    | 'external'
    | 'chevron-down'
    | 'arrow-right'
    | 'check-circle'
    | 'calendar'
    | 'clock'
    | 'tag'
    | 'download'
    | 'terminal';
  size?: number;
  title?: string;
  class?: string;
}

const { name, size = 20, title, class: className } = Astro.props;
---

{
