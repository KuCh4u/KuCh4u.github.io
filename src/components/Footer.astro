---
import Icon from './Icon.astro';
import type { Locale } from '../utils/i18n';
import { pathFor } from '../utils/i18n';
import type { UiStrings } from '../data/ui-strings';

interface Props {
  locale: Locale;
  name: string;
  nav: Record<string, string>;
  social: { linkedin: string; github: string; credly: string; hackthebox: string; tryhackme: string };
  email: string;
  ui: UiStrings;
}

const { locale, name, nav, social, email, ui } = Astro.props;
const home = pathFor(locale, '/');
const year = new Date().getFullYear();

const quickLinks = [
  { key: 'about', href: `${home}#about` },
  { key: 'projects', href: `${home}#projects` },
  { key: 'certifications', href: `${home}#certifications` },
  { key: 'contact', href: `${home}#contact` },
];

const socials = [
  { name: 'email', href: `mailto:${email}`, label: 'Email', external: false },
  { name: 'linkedin', href: social.linkedin, label: 'LinkedIn', external: true },
  { name: 'github', href: social.github, label: 'GitHub', external: true },
] as const;
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href={home} class="brand">NC<span class="brand__cursor" aria-hidden="true">_</span></a>
      <p>{name}</p>
      <p class="site-footer__tagline">{ui.footerTagline}</p>
    </div>

    <nav class="site-footer__links" aria-label={ui.navFooter}>
      <ul>
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href}>{nav[link.key]}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__social">
      {
        socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.external ? `${s.label} (${ui.opensNewTab})` : s.label}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
          >
            <Icon name={s.name} size={20} />
          </a>
        ))
      }
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {name}. {ui.footerRights}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-base);
    border-top: 1px solid var(--border-subtle);
    padding-block: var(--space-12) var(--space-6);
  }

  .site-footer__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .site-footer__brand p {
    margin-top: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .site-footer__tagline {
    font-family: var(--font-mono);
    color: var(--text-muted) !important;
    font-size: var(--text-xs) !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .site-footer__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
  }

  .site-footer__links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    background-image: linear-gradient(var(--accent-info), var(--accent-info));
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0% 1px;
    padding-bottom: 2px;
    transition:
      color var(--dur-fast) var(--ease-standard),
      background-size var(--dur-fast) var(--ease-standard);
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    color: var(--text-primary);
    background-size: 100% 1px;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-3);
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    color: var(--accent-primary);
  }

  .site-footer__bottom {
    padding-top: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  @media (min-width: 768px) {
    .site-footer__bottom {
      text-align: left;
    }
  }
</style>
