---
import Icon from './Icon.astro';
import { resolveShared } from '../data/ui-strings';
import type { UiStrings } from '../data/ui-strings';

interface Channel {
  type: 'email' | 'linkedin' | 'github' | 'credly' | 'hackthebox' | 'tryhackme';
  label: string;
  value: string;
}

interface Props {
  contact: { heading: string; subtitle: string; cta: string; note: string; channels: Channel[] };
  shared: Record<string, any>;
  ui: UiStrings;
}

const { contact, shared, ui } = Astro.props;

function hrefFor(channel: Channel) {
  const value = resolveShared(channel.value, shared);
  return channel.type === 'email' ? `mailto:${value}` : value;
}
---

<section id="contact" class="section section-surface contact" aria-labelledby="contact-heading">
  <div class="container contact__inner">
    <h2 class="section-title" id="contact-heading">{contact.heading}</h2>
    <p class="contact__subtitle">{contact.subtitle}</p>

    <div class="contact__channels">
      {
        contact.channels.map((channel) => {
          const isEmail = channel.type === 'email';
          return (
            <a
              href={hrefFor(channel)}
              class={`btn ${isEmail ? 'btn-primary' : 'btn-secondary'} contact__channel`}
              target={isEmail ? undefined : '_blank'}
              rel={isEmail ? undefined : 'noopener noreferrer'}
              aria-label={isEmail ? channel.label : `${channel.label} (${ui.opensNewTab})`}
            >
              <Icon name={channel.type} size={18} />
              {channel.label}
            </a>
          );
        })
      }
    </div>

    <p class="contact__note">{contact.note}</p>
  </div>
</section>

<style>
  .contact__inner {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
  }

  .contact__subtitle {
    margin-top: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-8);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .contact__channels {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  .contact__channel {
    width: 100%;
  }

  @media (min-width: 640px) {
    .contact__channel {
      width: auto;
    }
  }

  .contact__note {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
